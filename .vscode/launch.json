{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Sender (DAPLink)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/sender",
            "executable": "${workspaceFolder}/sender/build/Debug/sender.elf",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f1x.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "svdFile": "${workspaceFolder}/STM32F103xx.svd",
            "preLaunchTask": "Build Sender (Debug)"
        },
